# Copia este archivo a backend/.env y ajusta lo que necesites. Todo es opcional.

# --- Datos SPHEREx ---
SPHEREX_MODE=irsa                 # irsa (real) | mock (sintético, sin red)
SPHEREX_COLLECTION=spherex_dr1    # colección(es) SIA de IRSA, separadas por coma
DATA_RELEASE=SPHEREx DR1 (IRSA, colección spherex_dr1)
ZODI_SUBTRACT=true                # restar la luz zodiacal (extensión ZODI) antes de mostrar
CLEAN_BAD_PIXELS=true             # rellenar rayos cósmicos/píxeles calientes con sus vecinos
SPHEREX_SEARCH_TIMEOUT_S=20
SPHEREX_SEARCH_RETRIES=2          # reintentos (0.4 s, 0.8 s…) ante los 502 intermitentes de IRSA
DOWNLOAD_TIMEOUT_S=60
DOWNLOAD_CONCURRENCY=6
MAX_SPECTRUM_FRAMES=600

# --- Catálogos ---
WISE_CATALOG=allwise              # allwise | catwise
OVERLAY_MAX_SOURCES=5000

# --- Red ---
EXTERNAL_TIMEOUT_S=10
EXTERNAL_RETRIES=1

# --- Caché ---
CACHE_TTL_S=86400
CACHE_SIZE_LIMIT_GB=5

# --- Trabajos ---
MAX_CONCURRENT_JOBS=2
JOB_TTL_S=3600

# --- Límite de peticiones por IP ---
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_BURST=40
TRUST_PROXY=false                 # true si va detrás de un proxy que pone X-Forwarded-For

# Modelo ONNX de asteroides (asteroid_lstm.onnx + preprocessing.json)
# MODEL_DIR=/app/models
